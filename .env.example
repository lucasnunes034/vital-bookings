# Supabase Configuration
# Obtenha estas credenciais em: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project.supabase.co"

# Vite Environment Variables (expostas ao frontend)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Super Admin Email (opcional)
VITE_SUPER_ADMIN_EMAIL="admin@example.com"

# IMPORTANTE: Nunca commite o arquivo .env com valores reais!
# A chave SUPABASE_SERVICE_ROLE_KEY deve estar APENAS no servidor de produção
# e NUNCA deve ser exposta ao frontend ou commitada no Git.